# GENERATED by `go run ./cmd/build -env prod`. Do not edit; edit config/project.json.
# Non-secret settings only. Secrets live on the server and are NEVER in this file:
#   ~/.config/budol/ai.env (mode 600): AI_API_KEY=...  (the actual key)
#   ~/budol/budol-api.env (live copy of this file): TURNSTILE_SECRET, BUDOL_STATS_TOKEN, BUDOL_IP_SALT
BUDOL_ENV=prod
BUDOL_LISTEN=127.0.0.1:8790
ALLOWED_ORIGINS=https://abalol.xyz
# Honour X-Forwarded-For/X-Real-IP only from this peer (nginx on the same host).
TRUSTED_PROXY=127.0.0.1
# Set to 1 only when behind a Cloudflare tunnel (honours CF-Connecting-IP).
TRUST_CF_HEADERS=
MAX_TEXT_CHARS=1500
BUDOL_RATE_PER_MIN=6
BUDOL_RATE_BURST=3
AI_RATE_PER_HOUR=20
AI_MAX_CONCURRENT=3
AI_DAILY_CAP=150
# Workers AI free tier = 10,000 neurons per UTC day (reset 00:00 UTC = 08:00 Manila). The API
# estimates neurons per call and answers rules-only (ai_status quota) once this many are spent.
# Keep it below 10000 (margin for estimate error and other use of the account). 0 = off.
AI_DAILY_NEURON_BUDGET=8000
CAP_TZ=Asia/Manila
AI_TIMEOUT_S=25
# Non-secret Cloudflare account id. Must stay ABOVE AI_BASE_URL: ensure.sh
# sources this file with bash, which expands ${CF_ACCOUNT_ID} on that line.
CF_ACCOUNT_ID=
AI_API_STYLE=openai_chat
AI_BASE_URL=https://api.cloudflare.com/client/v4/accounts/${CF_ACCOUNT_ID}/ai/v1
AI_MODEL=@cf/openai/gpt-oss-120b
AI_FALLBACK_MODEL=@cf/openai/gpt-oss-20b
AI_FALLBACK_STYLE=openai_chat
# NAME of the env var holding the key (the key itself is NOT stored here).
AI_KEY_ENV=AI_API_KEY
AI_MAX_OUTPUT_TOKENS=2500
AI_TEMPERATURE=0.2
AI_REASONING_EFFORT=
AI_CHAT_REASONING_EFFORT=low
AI_JSON_MODE=
TURNSTILE_HOSTNAMES=abalol.xyz
# Secrets below are EMPTY here by design; set them in the live ~/budol/budol-api.env:
# TURNSTILE_SECRET=
# BUDOL_STATS_TOKEN=
# BUDOL_IP_SALT=
